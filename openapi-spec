  examples:
    AdvancedSearchRequestExample:
      highUserCount:
        summary: Search for high user count
        value:
          sorting: 'userCount'
          sortDirection: 'desc'
          index: 'extension'
          fields:
            operator: 'AND'
            conditions:
              - column: 'userCount'
                operator: '>='
                value: 100000
      highUserCountWithLowRating:
        summary: Search for high user count with low ratings
        value:
          sorting: userCount
          sortDirection: desc
          index: extension
          fields:
            operator: AND
            conditions:
              - column: userCount
                operator: '>='
                value: 100000
              - column: ratingValue
                operator: '<'
                value: '3'
      permissionsSearch:
        summary: Search for cookies permissions with <all_urls>
        value:
          sorting: userCount
          sortDirection: desc
          index: extension
          fields:
            operator: AND
            conditions:
              - column: manifest.permissions
                operator: '='
                value: cookies
              - column: manifest.host_permissions
                operator: '='
                value: '<all_urls>'
      searchPermissionsOrOptionalPermissions:
        summary: Search by permissions or optional permissions
        value:
          sorting: userCount
          sortDirection: desc
          index: extension
          fields:
            operator: OR
            groups:
              - operator: AND
                conditions:
                  - column: manifest.permissions
                    operator: '='
                    value: cookies
              - operator: AND
                conditions:
                  - column: manifest.optional_permissions
                    operator: '='
                    value: cookies
      searchReviewText:
        summary: Search for user reviews with certain text
        value:
          sorting: rating
          sortDirection: desc
          index: reviews
          fields:
            operator: AND
            conditions:
              - column: body
                operator: '='
                value: Very good
      searchReviewByAuthor:
        summary: Search for user reviews by author name
        value:
          sorting: timestamp
          sortDirection: desc
          index: reviews
          fields:
            operator: AND
            conditions:
              - column: authorName
                operator: '='
                value: Tester
