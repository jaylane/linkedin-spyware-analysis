openapi: 3.0.0
info:
  title: Chrome-Stats API
  description: |
    Please use `https://chrome-stats.com` as the API server.

    ### Getting API Keys:
    In order to use our API, you will need to create an API key in the [Chrome-Stats API key console](/myprofile).

    Note that some APIs are only available to premium users.

    The API key allows us to identify your request, grant access to premium resources, bypass the web application firewall, etc. Once you have a valid API key, you can also try the API calls directly here.

    When using an API, be sure to include your API key in the request header `x-api-key: <your-api-key>`. Do **NOT** share your API keys with other users.

    ### Rate Limits and Quota:

    Our API rate limit:

    - Enterprise members: **Unlimited**
    - Premium members: **10,000** requests / day
    - Non-premium members: **100** requests / month

    If your usage is above the limit, you will get a 429 status response. Please slow down your request before trying again, or [upgrade to a higher membership tier](/pricing).

    We don't enforce rate-limiting for Enterprise users. Just please be courteous and do not DoS our servers.

    ### Paginations:

    Some of our APIs support pagination via the "page" URL parameters. Pagination starts at page=1. Pagination is only available for Pro and Premium members. Free members requesting page > 1 will get an error.

    ### Webhook Verification:

    Chrome-Stats webhooks can be secured using a shared secret to verify the authenticity of webhook requests. This section explains how to implement webhook signature verification in your application.

    #### Setting up a Shared Secret

    1. Go to the [API Keys console](/myprofile)
    2. When adding or editing a webhook, enter a secure string in the "Shared Secret" field
    3. Save your webhook configuration

    #### Verifying Webhook Signatures

    When a webhook is sent to your endpoint, Chrome-Stats includes a signature in the `X-Chrome-Stats-Signature` header. This signature is a HMAC SHA-256 hash of the request body, using your shared secret as the key.

    To verify the signature:

    1. Extract the signature from the `X-Chrome-Stats-Signature` header
    2. Compute the HMAC SHA-256 hash of the raw request body using your shared secret
    3. Compare the computed hash with the signature from the header
    4. If they match, the webhook is authentic and hasn't been tampered with

    #### Code Examples

    **Node.js**
    ```javascript
    const crypto = require('crypto');

    // Express.js example
    app.post('/webhook', express.raw({type: 'application/json'}), (req, res) => {
      const signature = req.headers['x-chrome-stats-signature'];
      const body = req.body; // Raw request body
      const sharedSecret = 'your_shared_secret';

      // Compute the expected signature
      const expectedSignature = crypto
        .createHmac('sha256', sharedSecret)
        .update(body)
        .digest('hex');

      // Compare signatures
      if (crypto.timingSafeEqual(
        Buffer.from(signature),
        Buffer.from(expectedSignature)
      )) {
        // Signature is valid, process the webhook
        const payload = JSON.parse(body);
        // Process webhook payload...
        res.status(200).send('Webhook received');
      } else {
        // Invalid signature
        res.status(401).send('Invalid signature');
      }
    });
    ```

    **Python**
    ```python
    import hmac
    import hashlib
    from flask import Flask, request, jsonify

    app = Flask(__name__)

    @app.route('/webhook', methods=['POST'])
    def webhook():
        # Get the signature from the header
        signature = request.headers.get('X-Chrome-Stats-Signature')

        # Get the raw request body
        request_data = request.get_data()

        # Your shared secret
        shared_secret = 'your_shared_secret'

        # Compute the expected signature
        expected_signature = hmac.new(
            shared_secret.encode('utf-8'),
            request_data,
            hashlib.sha256
        ).hexdigest()

        # Compare signatures
        if hmac.compare_digest(signature, expected_signature):
            # Signature is valid, process the webhook
            payload = request.json
            # Process webhook payload...
            return jsonify({'status': 'success'}), 200
        else:
            # Invalid signature
            return jsonify({'status': 'error', 'message': 'Invalid signature'}), 401
    ```
  version: 1.0.0
servers:
  - url: https://chrome-stats.com
securitySchemes:
  apiKey:
    type: apiKey
    in: header
    name: x-api-key
    description: API key required for access. Obtain from the [Chrome-Stats API key console](/myprofile).
security:
  - apiKey: []

paths:
  /api/detail:
    get:
      description: |
        Retrieve details of a browser extension.

        This API is available to all users. However, paid members can see additional fields in the response.
      operationId: getExtensionDetails
      parameters:
        - name: id
          in: query
          required: true
          schema:
            type: string
          description: Chrome extension ID, Android package ID, Edge add-on id, or Firefox add-on id.
          examples:
            chrome:
              value: bmnlcjabgnpnenekpadlanbbkooimhnj
            android:
              value: com.joinhoney.honeyandroid
            edge:
              value: amnbcmdbanbkjhnfoeceemmmdiepnbpp
            firefox:
              value: honey
      responses:
        '200':
          description: OK
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ExtensionDetails'
        '429':
          description: Rate limit exceeded
  /api/list-versions:
    get:
      description: Returns a list of downloadable versions for an extension
      operationId: listExtensionVersions
      parameters:
        - name: id
          in: query
          required: true
          schema:
            type: string
          description: Extension / app ID. e.g., bmnlcjabgnpnenekpadlanbbkooimhnj
          example: bmnlcjabgnpnenekpadlanbbkooimhnj
      responses:
        '200':
          description: A list of available versions and types.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ListVersionsResponse'
        '429':
          description: Rate limit exceeded
  /api/download:
    get:
      description: Download a browser extension version
      operationId: downloadExtension
      parameters:
        - name: id
          in: query
          required: true
          schema:
            type: string
          description: Extension / app ID. e.g., bmnlcjabgnpnenekpadlanbbkooimhnj
          example: bmnlcjabgnpnenekpadlanbbkooimhnj
        - name: type
          in: query
          required: true
          schema:
            type: string
            enum:
              - ZIP
              - CRX
          description: The file format to download.
          example: ZIP
        - name: version
          in: query
          required: true
          schema:
            type: string
          description: The specific version string to download, or `latest` to download the most recent version.
          example: latest
        - name: versionCode
          in: query
          required: false
          schema:
            type: string
          description: Advanced use-case for Chrome/Edge only. In the very rare case scenario the version is a version_name associated with multiple versionCodes, specify this to download the specific versionCode. Most users should not need to use this.
      responses:
        '200':
          description: The extension file as a binary stream.
          content:
            application/zip:
              schema:
                type: string
                format: binary
            application/x-chrome-extension:
              schema:
                type: string
                format: binary
            application/octet-stream:
              schema:
                type: string
                format: binary
        '429':
          description: Rate limit exceeded
  /api/trends:
    get:
      description: Get historical data trends for an extension
      operationId: getExtensionTrends
      parameters:
        - name: id
          in: query
          required: true
          schema:
            type: string
          description: Extension / app ID. e.g., bmnlcjabgnpnenekpadlanbbkooimhnj
          example: bmnlcjabgnpnenekpadlanbbkooimhnj
        - name: numDays
          in: query
          required: false
          schema:
            type: number
          description: Number of days to fetch. If this number exceeds the max days allowed for your account tier, then it will be reduced the max allowed number.
          example: 7
      responses:
        '200':
          description: Historical trend data for the extension.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TrendData'
        '429':
          description: Rate limit exceeded
  /api/reviews:
    get:
      description: Retrieve user reviews
      operationId: getExtensionReviews
      parameters:
        - name: id
          in: query
          required: true
          schema:
            type: string
          description: Extension / app ID. e.g., bmnlcjabgnpnenekpadlanbbkooimhnj
          example: bmnlcjabgnpnenekpadlanbbkooimhnj
        - name: page
          in: query
          required: false
          schema:
            type: number
            default: 1
          description: Pagination. Starts at 1. Up to at most 10 records (100 pages).
      responses:
        '200':
          description: A list of user reviews for the extension.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ReviewsResponse'
        '429':
          description: Rate limit exceeded
  /api/reviews/realtime:
    get:
      description:
        Retrieve the most recent user reviews from the Chrome Web Store, Google Play Store, Edge add-on
        store, or Firefox add-on store. Unlike `/api/reviews`, this operation will retrieve the latest data from the
        store's reviews, and may be less reliable. It only supports getting the latest reviews without pagination
        support.
      operationId: getExtensionReviewsRealtime
      parameters:
        - name: id
          in: query
          required: true
          schema:
            type: string
          description: Extension / app ID. e.g., bmnlcjabgnpnenekpadlanbbkooimhnj
          example: bmnlcjabgnpnenekpadlanbbkooimhnj
        - name: hl
          in: query
          required: false
          schema:
            type: string
          description: Only relevant for Android. The language code of the reviews to retrieve. If not set, default to en.
          example: en, es (Spanish), zh-CN (Chinese simplified), vi (Vietnamese)
      responses:
        '200':
          description: A realtime snapshot of user reviews for the extension.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/RealtimeReviewsResponse'
        '429':
          description: Rate limit exceeded
  /api/submit-extension:
    post:
      summary: Submit an extension or app URL to be added to Chrome-Stats
      description: |
        Submit a browser extension or app URL to be added to Chrome-Stats.

        The URL must match one of the supported store URL formats for Chrome Web Store, Google Play Store,
        Microsoft Edge Add-ons, or Firefox Add-ons.

        If the success field returns true, you can use the /api/detail API to get the extension details.

        If the extension already exists in Chrome-Stats, the success field will be true and the operation is a no-op.
      operationId: submitExtension
      requestBody:
        description: JSON payload containing the URL of the extension or app to be added.
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - url
              properties:
                url:
                  type: string
                  format: uri
                  description: >-
                    The full store URL of the extension or app. Must match one of the supported
                    vendor store URL formats (e.g., Chrome Web Store, Google Play Store, Edge
                    Add-ons, Firefox Add-ons).
                  example: https://chromewebstore.google.com/detail/extension-name/bmnlcjabgnpnenekpadlanbbkooimhnj
      responses:
        '200':
          description: Result of the submission request.
          content:
            application/json:
              schema:
                type: object
                properties:
                  message:
                    type: string
                    description: Human-readable status message about the submission.
                  success:
                    type: boolean
                    description: >-
                      Indicates whether the URL is a valid extension URL.
                  isNew:
                    type: boolean
                    description: >-
                      Indicates whether the extension is newly added.
                  link:
                    type: string
                    nullable: true
                    description: >-
                      Optional link to the existing extension/app details page on Chrome-Stats
                      if the item is already in the system. Only set when success is false.
              examples:
                queued:
                  summary: URL queued for crawling
                  value:
                    message: >-
                      The requested extension has been added to our queue to crawl. If it is
                      publicly accessible, the extension will show up on our website within the
                      next 24-48 hours.
                    success: true
                alreadyExists:
                  summary: Extension already exists in Chrome-Stats
                  value:
                    message: The requested extension already exists in our system.
                    link: /d/bmnlcjabgnpnenekpadlanbbkooimhnj
                    linkText: Go to Example Extension
        '429':
          description: Rate limit exceeded
  /api/{platform}/ranking:
    get:
      summary: Retrieve extension ranking for a namespace
      operationId: getExtensionRanking
      description: |
        Return a list of extensions, sorted by their ranking in the given namespace.
        A namespace can be the overall-rank, or the type of item in Chrome Web Store (extension, app, or theme), or a category.
      parameters:
        - name: platform
          in: path
          required: true
          schema:
            type: string
            enum:
              - chrome
              - android
              - edge
              - firefox
          description: Browser/platform name.
          example: chrome
        - name: namespace
          in: query
          required: true
          schema:
            type: string
          description: The ranking namespace (e.g., `overall-rank`, `extension-rank`, `app-rank`, `theme-rank`, or category ranking in the format `cat-{category}-rank` such as `cat-lifestyle/shopping-rank`).
          example: overall-rank
        - name: page
          in: query
          required: false
          schema:
            type: number
            default: 1
          description: Pagination. Starts at 1.
      responses:
        '200':
          description: A list of extensions ranked within the specified namespace.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/RankResponse'
        '429':
          description: Rate limit exceeded
  /api/{platform}/raw-data:
    get:
      description: |
        **(Premium members only)** List available raw data CSVs to download.
      operationId: listRawData
      parameters:
        - name: platform
          in: path
          required: true
          schema:
            type: string
            enum:
              - chrome
              - android
              - edge
              - firefox
          description: Browser/platform name.
          example: chrome
        - name: numDays
          in: query
          required: true
          schema:
            type: number
          description: Number of days to fetch. This may not exceed the max number of days allowed by your plan.
          example: 7
      responses:
        '200':
          description: A list of raw data CSV file keys (names).
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/RawDataList'
        '429':
          description: Rate limit exceeded
  /api/{platform}/download-raw-data:
    get:
      operationId: downloadRawData
      description: |
        **(Premium members only)** Download a specified raw data CSV.

        Note that this endpoint will redirect to a S3 URL for download, and should not be used within the browser due to CORS restriction.
      parameters:
        - name: platform
          in: path
          required: true
          schema:
            type: string
            enum:
              - chrome
              - android
              - edge
              - firefox
          description: Browser/platform name.
          example: chrome
        - name: key
          in: query
          required: true
          schema:
            type: string
          description: The raw data CSV file name provided by the /api/{platform}/raw-data API.
          example: ranking-stats/2025/ranking-stats-20250508.csv
      responses:
        '200':
          description: The extension file as a binary stream.
          content:
            application/octet-stream:
              schema:
                type: string
                format: binary
        '429':
          description: Rate limit exceeded
  /api/{platform}/advanced-search:
    post:
      description: |
        **(Premium members only)** Run an advanced search query for extensions or reviews
      operationId: advancedSearch
      parameters:
        - name: platform
          in: path
          required: true
          schema:
            type: string
            enum:
              - chrome
              - android
              - edge
              - firefox
          description: Browser/platform name.
          example: chrome
      requestBody:
        description: The JSON body defining the advanced search query. The best way to construct this query is go to the [Advanced Search page](/chrome/advanced/extension-search) and use the "Export API query" feature. Note that not all fields in the extensions may be available in the response here. Up to at most 10K records (400 pages) can be retrieved per query.
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AdvancedSearchRequest'
            examples:
              $ref: '#/components/examples/AdvancedSearchRequestExample'
      responses:
        '200':
          description: Search results matching the query.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AdvancedSearchResult'
        '400':
          description: Invalid request body or query parameters.
        '429':
          description: Rate limit exceeded
  /api/{platform}/search-source:
    get:
      summary: Run an advanced search on source codes
      operationId: searchSourceCode
      description: |
        **(Premium members only)** Search for a string within the extension source codes. Note the following limitations:
        * Only the latest version of each extension is indexed
        * Only *.js and *.json files (exclude locales/ json files) are indexed
        * Only files that are <500KB are indexed
        * Only support Chrome, Edge, and Firefox
      parameters:
        - name: platform
          in: path
          required: true
          schema:
            type: string
            enum:
              - chrome
              - edge
              - firefox
          description: Browser/platform name.
          example: chrome
        - name: q
          in: query
          required: true
          schema:
            type: string
          description: The string to search for within source code.
          example: localStorage
        - name: id
          in: query
          required: false
          schema:
            type: string
          description: If specified, limit the search to the source codes for this extension ID.
        - name: page
          in: query
          required: false
          schema:
            type: number
            default: 1
          description: Pagination. Start from 1. Up to at most 10K records (400 pages).
      responses:
        '200':
          description: A list of source code matches found.
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/SourceSearchResult'
        '429':
          description: Rate limit exceeded

webhooks:
  securityScheme:
    description: |
      ## Webhook Security with Shared Secret

      Chrome-Stats webhooks support signature verification using a shared secret to ensure the authenticity of webhook requests.

      ### How it works:

      1. When setting up a webhook in the [API Keys console](/myprofile), you can provide an optional shared secret.
      2. When Chrome-Stats sends a webhook to your endpoint, it will include a signature in the `X-Chrome-Stats-Signature` header.
      3. This signature is a HMAC SHA-256 hash of the request body, using your shared secret as the key.
      4. Your server can verify this signature to ensure the webhook was sent by Chrome-Stats and hasn't been tampered with.

      For detailed implementation examples, see the [Webhook Verification](#section/Webhook-Verification) section.

  raw-data-updated:
    post:
      summary: (Premium members only) Raw Data Updated Event
      description: |
        Webhooks allow you to receive programmatic calls when our data is updated. Webhooks are only configurable for [Premium members](/pricing). You can add your webhook endpoint in the [API Keys console](/myprofile).

        In case the Webhook request failed, we may try calling it again several times. Please ensure that your webhook endpoint returns a success HTTP status code of `200` to avoid unnecessary retries.

        RawDataUpdated webhook is called at least once a day when all the raw data CSVs are available for download.
        Typically around **UTC 13:00-15:00**, but could be later.
      requestBody:
        description: |
          **raw-data-updated** webhook event payload.
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/RawDataUpdatedPayload'
      responses:
        '200':
          description: Success - Webhook received and processed successfully.

  tracking:
    post:
      summary: (Premium members only) Stats Tracking Event
      description: |
        Webhooks allow you to receive programmatic calls when our data is updated. Webhooks are only configurable for [Premium members](/pricing). You can add your webhook endpoint in the [API Keys console](/myprofile).

        In case the Webhook request failed, we may try calling it again several times. Please ensure that your webhook endpoint returns a success HTTP status code of `200` to avoid unnecessary retries.

        Tracking webhook is called at least once a day when the stats for extensions are updated.
        Typically around **UTC 13:00-15:00**, but could be later.
      requestBody:
        description: |
          **tracking** webhook event payload.
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/TrackingPayload'
      responses:
        '200':
          description: Success - Webhook received and processed successfully.

  on-update:
    post:
      summary: (Premium members only) Extension Update Event
      description: |
        Webhooks allow you to receive programmatic calls when extensions are updated. Webhooks are only configurable for [Premium members](/pricing). You can add your webhook endpoint in the [API Keys console](/myprofile).

        In case the Webhook request failed, we may try calling it again several times. Please ensure that your webhook endpoint returns a success HTTP status code of `200` to avoid unnecessary retries.

        On-update webhook is called when an extension you're tracking has new important data updates, such as name changes, permission changes, risk level changes, etc..
      requestBody:
        description: |
          **on-update** webhook event payload.
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/OnUpdatePayload'
      responses:
        '200':
          description: Success - Webhook received and processed successfully.

  new-reviews:
    post:
      summary: (Premium members only) New User Reviews Event
      description: |
        Webhooks allow you to receive programmatic calls when extensions are updated. Webhooks are only configurable for [Premium members](/pricing). You can add your webhook endpoint in the [API Keys console](/myprofile).

        In case the Webhook request failed, we may try calling it again several times. Please ensure that your webhook endpoint returns a success HTTP status code of `200` to avoid unnecessary retries.

        New-reviews webhook is called when an extension you're tracking has received a new user review.
      requestBody:
        description: |
          **new-reviews** webhook event payload.
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/NewReviewsPayload'
      responses:
        '200':
          description: Success - Webhook received and processed successfully.

components:
  schemas:
    ScreenshotMedia:
      type: object
      description: Details for a screenshot media item.
      properties:
        screenshot:
          type: string
          format: uri
          description: URL of the screenshot image.
          example: 'https://lh3.googleusercontent.com/yGbxe4YlD15omKa1_vejkoLncLDeWNrpajsEh6pjJiktSCjBg_DFU5UlFYLfwO_SCfUe6qwG_aNoDX-0uQRHQDtA'

    VideoMedia:
      type: object
      description: Details for a video media item, including thumbnail.
      properties:
        video:
          type: string
          format: uri
          description: URL of the video (e.g., YouTube embed URL).
          example: 'https://www.youtube.com/embed/diE6kJriHsg?rel=0&wmode=opaque&enablejsapi=1'

    MediaItem:
      description: Represents a single media item, which can be either a screenshot or a video with thumbnail.
      oneOf:
        - $ref: '#/components/schemas/ScreenshotMedia'
        - $ref: '#/components/schemas/VideoMedia'

    BasicExtensionItem:
      type: object
      description: Represents an alternative item, potentially for another platform or similar functionality. Note that fields might vary slightly by platform in practice, this schema includes common ones and makes platform-specific ones nullable where observed.
      properties:
        id:
          type: string
          description: Unique ID of the alternative item on its platform.
          example: 'chhjbpecpncaggjpdakmflnfcopglcmi'
        name:
          type: string
          description: Name of the alternative item.
          example: 'Rakuten: Get Cash Back For Shopping'
        logo:
          type: string
          format: uri
          description: URL of the alternative item's logo.
          example: 'https://lh3.googleusercontent.com/R3pk1oNclcQ0t5eJxAdQxv9A3SOtKdmycyA1ODSNBf0ILn1VxV2VG6t4XVyAnBQ3gLB5ETiv1AHCziEZmEtwpriyUFs'
        author:
          type: string
          description: Author or publisher information for the alternative item.
          example: 'https://rakuten.com'
        ratingValue:
          type: number
          format: float
          description: Average user rating for the alternative item.
          example: 4.888344513381717
        ratingCount:
          type: integer
          description: Total number of ratings for the alternative item.
          example: 43679
        userCount:
          type: integer
          description: Number of users for the alternative item.
          example: 3000000
        version:
          type: string
          description: Version of the alternative item.
          example: '17.0.5'

    DeltaStats:
      type: object
      description: Change in key metrics over a period (e.g., one day or one week).
      properties:
        userCount:
          type: integer
          description: Change in user count.
          example: 0
        ratingValue:
          type: number
          format: float
          description: Change in average user rating.
          example: -0.00013395165128660125
        ratingCount:
          type: integer
          description: Change in total number of ratings.
          example: -5

    RankingValue:
      type: object
      description: Map of ranking keys (e.g., 'overall-rank', 'keyword-...') to integer rank values.
      additionalProperties:
        type: integer
      example:
        overall-rank: 20
        extension-rank: 18
        keyword-browser_extension-rank: 135
        cat-lifestyle/shopping-rank: 1
        keyword-paypal-rank: 1
        featured: 9

    RankingEntry:
      type: object
      description: A snapshot of ranking data at a specific time.
      properties:
        ts:
          type: string
          description: Timestamp for the ranking data (YYYYMMDD format).
          example: '20250508'
        value:
          $ref: '#/components/schemas/RankingValue'

    ReviewSummary:
      type: object
      description: A summary of user reviews, including pros, cons, and an overall summary.
      properties:
        pros:
          type: array
          items:
            type: string
          description: List of positive points extracted from reviews.
          example:
            - 'Users have saved money using Honey coupons and discounts.'
        cons:
          type: array
          items:
            type: string
          description: List of negative points extracted from reviews.
          example:
            - 'Honey allegedly does not always find the best coupons and sometimes shows only store-partnered deals.'
        summary:
          type: string
          description: Overall summary of the reviews.
