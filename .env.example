# Copy this file to `.env` and fill in real values.
# `.env` is gitignored. NEVER commit a real value of any of these.

# --- Chrome-Stats Pro API key ---
# Used by scripts/chrome_stats_client.py to enrich extension lookups with
# Chrome-Stats data (user counts, ratings, removal status, etc.).
# Sign up at https://chrome-stats.com/ to get one.
CHROME_STATS_API_KEY=
