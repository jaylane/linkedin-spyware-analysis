# Copy this file to `.env` and fill in real values.
# `.env` is gitignored. NEVER commit a real value of any of these.

# --- Chrome-Stats Pro API key ---
# Used by scripts/chrome_stats_client.py to enrich extension lookups with
# Chrome-Stats data (user counts, ratings, removal status, etc.).
# Sign up at https://chrome-stats.com/ to get one.
CHROME_STATS_API_KEY=

# --- (future) Anthropic / OpenAI API key for the LLM-augmented analysis tier ---
# Optional. Phase 3 of CRXray uses an LLM to compare an extension's stated
# description against its actual code behavior. Pick whichever you have.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- (future) GitHub token for committing nightly snapshots ---
# Used by automated jobs that re-run scripts/cross_reference_malicious.py and
# update the malicious-DB snapshot. Optional — only needed if you wire up
# unattended scheduling.
# GITHUB_TOKEN=
